<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/content_bg">

    <!-- ========================================================= -->
    <!-- LEFT NAVIGATION -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/nav_column"
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp"
        android:background="@color/nav_bg">

        <!-- App Logo / Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:text="BROWSER"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Small divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="20dp"
            android:background="#18FFFFFF" />

        <!-- Home -->
        <TextView
            android:id="@+id/nav_home"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="Home"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/nav_button_bg" />

        <!-- History -->
        <TextView
            android:id="@+id/nav_history"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="History"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/nav_button_bg" />

        <!-- Bookmarks -->
        <TextView
            android:id="@+id/nav_bookmarks"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="Bookmarks"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/nav_button_bg" />

        <!-- Downloads -->
        <TextView
            android:id="@+id/nav_downloads"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="Downloads"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/nav_button_bg" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- RIGHT CONTENT -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">


        <!-- ===================================================== -->
        <!-- TOP SEARCH BAR -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Search Container -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="6dp"
                android:background="@drawable/bg_search_bar">

                <!-- Search Icon -->
                <TextView
                    android:layout_width="34dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⌕"
                    android:textColor="#8EFFFFFF"
                    android:textSize="25sp" />

                <!-- URL Input -->
                <EditText
                    android:id="@+id/url_edit_text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:background="@android:color/transparent"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#7AFFFFFF"
                    android:textSize="15sp"
                    android:hint="Search or enter URL"
                    android:padding="0dp"
                    android:focusable="true" />

                <!-- Bookmark -->
                <TextView
                    android:id="@+id/bookmark_star"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="☆"
                    android:textColor="#BFFFFFFF"
                    android:textSize="25sp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/small_focus_bg" />

            </LinearLayout>


            <!-- GO BUTTON -->

            <Button
                android:id="@+id/go_button"
                android:layout_width="70dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="Go"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:background="@drawable/go_button_bg"
                android:focusable="true"
                android:clickable="true"
                android:minWidth="0dp"
                android:minHeight="0dp" />

        </LinearLayout>


        <!-- ===================================================== -->
        <!-- SECTION TITLE -->
        <!-- ===================================================== -->

        <TextView
            android:id="@+id/content_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"
            android:text="Home"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium" />




        <!-- ===================================================== -->
        <!-- BOOKMARK GRID -->
        <!-- ===================================================== -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/content_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="8dp" />



    </LinearLayout>

</LinearLayout>